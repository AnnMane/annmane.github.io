---
const groups = [
  {
    category: 'Data Visualization',
    color: '#f2c80f',
    skills: [
      { name: 'Excel',     note: 'Pivot Tables · Power Query · Advanced Functions'  },
      { name: 'Power BI',  note: 'DAX · Power Query · Data Modeling · Star Schema' },
    ],
  },
  {
    category: 'Languages & Databases',
    color: '#3776ab',
    skills: [
      { name: 'SQL',    note: 'PostgreSQL · Queries · Joins · Window Functions' },
      { name: 'Python', note: 'Pandas · NumPy · Matplotlib · BeautifulSoup' },
    ],
  },
  {
    category: 'Tools & Environment',
    color: '#06b6d4',
    skills: [
      { name: 'Git & GitHub',    note: 'Version control · Collaboration' },
      { name: 'VS Code',         note: 'Primary IDE'                      },
      { name: 'Caseware IDEA',   note: 'Audit analytics'                  },
      { name: 'Linux / WSL',     note: 'Ubuntu terminal'                  },
    ],
  },
  {
    category: 'Certifications',
    color: '#7c3aed',
    skills: [
      { name: 'Python Bootcamp',        note: 'Udemy · 2025'              },
      { name: 'SQL Bootcamp',           note: 'Udemy'                     },
      { name: 'Power BI DA Associate',  note: 'In progress · Microsoft'   },
    ],
  },
];
---

<section id="skills" class="section px-4" style="position: relative; overflow: hidden;">

  <!-- Orb accent -->
  <div class="orb orb-c" style="width:450px; height:450px; top:-80px; right:-100px; opacity:0.45;"></div>

  <div class="max-w-6xl mx-auto" style="position: relative; z-index: 1;">

    <div class="mb-10 sr sr-up">
      <p class="section-eyebrow">Tech Stack</p>
      <h2 class="section-title">Skills</h2>
      <p class="section-sub">Tools and technologies I use to turn data into insight.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {groups.map((group, i) => (
        <div class={`pbi-visual tilt sr sr-d${i + 1}`}>
          <div class="pbi-header" style={`border-top: 3px solid ${group.color};`}>
            <span class="pbi-header-title" style={`color: ${group.color}; opacity: 0.85;`}>
              {group.category}
            </span>
            <span class="pbi-header-dots">···</span>
          </div>
          <div style="divide-color: var(--border);">
            {group.skills.map(skill => (
              <div class="px-4 py-3 transition-colors" style="border-bottom: 1px solid var(--border-2);"
                   onmouseover="this.style.background='var(--surface-2)'"
                   onmouseout="this.style.background=''">
                <div class="text-[13px] font-medium" style="color: var(--t1);">{skill.name}</div>
                <div class="text-[11px] mt-0.5" style="color: var(--t3);">{skill.note}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div><!-- /max-w -->
</section>
