---
const groups = [
  {
    category: 'Data Visualization',
    color: '#f2c80f',
    skills: [
      { name: 'Power BI',  note: 'DAX · Power Query · Data Modeling · Star Schema' },
      { name: 'Excel',     note: 'Pivot Tables · Power Query · Advanced Functions'  },
    ],
  },
  {
    category: 'Languages & Databases',
    color: '#3776ab',
    skills: [
      { name: 'Python', note: 'Pandas · NumPy · Matplotlib · BeautifulSoup' },
      { name: 'SQL',    note: 'PostgreSQL · Queries · Joins · Window Functions' },
    ],
  },
  {
    category: 'Tools & Environment',
    color: '#06b6d4',
    skills: [
      { name: 'Git & GitHub',    note: 'Version control · Collaboration' },
      { name: 'VS Code',         note: 'Primary IDE'                      },
      { name: 'Alteryx',         note: 'Workflow automation · ETL'        },
      { name: 'Caseware IDEA',   note: 'Audit analytics'                  },
      { name: 'Linux / WSL',     note: 'Ubuntu terminal'                  },
    ],
  },
  {
    category: 'Certifications',
    color: '#7c3aed',
    skills: [
      { name: 'Power BI Data Analyst Associate', note: 'Microsoft / Udemy' },
      { name: 'Python Bootcamp',                 note: 'Udemy · 2025'      },
      { name: 'SQL Bootcamp',                    note: 'Udemy'             },
    ],
  },
];
---

<section id="skills" class="section px-4">
  <div class="max-w-6xl mx-auto">

    <div class="flex items-center gap-3 mb-4">
      <div class="w-1 h-6 bg-[#06b6d4] rounded-full"></div>
      <h2 class="text-xl font-bold text-[#e6edf3] tracking-tight">Skills</h2>
      <span class="text-[11px] text-[#8b949e] uppercase tracking-widest">· tech stack</span>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {groups.map(group => (
        <div class="pbi-visual">
          <!-- Visual header with colored top border -->
          <div class="pbi-header" style={`border-top: 3px solid ${group.color};`}>
            <span class="pbi-header-title" style={`color: ${group.color}; opacity: 0.85;`}>
              {group.category}
            </span>
            <span class="pbi-header-dots">···</span>
          </div>

          <!-- Skills list styled like a PBI table -->
          <div class="divide-y divide-[#2a2d35]">
            {group.skills.map((skill, i) => (
              <div class="px-4 py-3 hover:bg-[#111318] transition-colors">
                <div class="text-[13px] font-medium text-[#e6edf3]">{skill.name}</div>
                <div class="text-[11px] text-[#8b949e] mt-0.5">{skill.note}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
