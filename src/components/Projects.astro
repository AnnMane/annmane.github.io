---
const projects = [
  {
    title: 'IT Job Market Analysis Dashboard',
    year: '2026',
    description:
      'End-to-end ETL pipeline scraping 2,400+ job postings with Python & BeautifulSoup, modeled into a Star Schema with bridge tables, and visualized in a 3-page interactive Power BI dashboard.',
    highlights: [
      'Scraped 2,400+ active job postings',
      'Star Schema with bridge table for many-to-many skills',
      'DAX context transition for dynamic salary averages',
      'Interactive 3-page UX-focused dashboard',
    ],
    tech: ['Python', 'Power BI', 'BeautifulSoup', 'Pandas', 'DAX', 'Power Query'],
    github: 'https://github.com/AnnMane',
    playUrl: null,
    accentColor: '#7c3aed',
  },
  {
    title: 'Global Streaming Catalog Analysis',
    year: '2025',
    description:
      'Combined Netflix, Amazon, and Disney+ datasets into a single analytical model using Power Query. Engineered composite Primary Keys to resolve cross-platform ID collisions.',
    highlights: [
      'Unified 3 streaming platforms into one model',
      'Composite PKs resolving cross-platform ID collisions',
      'Dark-mode dashboard with custom navigation & drill-through',
    ],
    tech: ['Power BI', 'Power Query', 'DAX'],
    github: 'https://github.com/AnnMane',
    playUrl: null,
    accentColor: '#06b6d4',
  },
  {
    title: 'Saper / Minesweeper',
    year: '2024',
    description:
      'Python + Tkinter Minesweeper with BFS flood-fill, combo scoring ×5, earthquake mechanic and X-Ray power-up. Rebuilt as a playable browser game.',
    highlights: [
      'BFS flood-fill cascade',
      'Combo ×5 multiplier scoring system',
      'Safe first click — 3×3 mine exclusion zone',
      'Three difficulty levels: Beginner → Expert',
    ],
    tech: ['Python', 'Tkinter', 'JavaScript'],
    github: 'https://github.com/AnnMane/minesweeper-python',
    playUrl: '/minesweeper',
    accentColor: '#f59e0b',
  },
];
---

<section id="projects" class="section px-4" style="position: relative; overflow: hidden;">

  <!-- Orb accent -->
  <div class="orb orb-v" style="width:500px; height:500px; top:-100px; left:-150px; opacity:0.5;"></div>

  <div class="max-w-6xl mx-auto" style="position: relative; z-index: 1;">

    <div class="mb-10 sr sr-up">
      <p class="section-eyebrow">Featured Work</p>
      <h2 class="section-title">Projects</h2>
      <p class="section-sub">End-to-end data projects — from raw scraping to polished dashboards.</p>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      {projects.map((project, i) => (
        <article class={`pbi-visual tilt flex flex-col sr sr-d${i + 1}`}>
          <div class="pbi-header" style={`border-top: 3px solid ${project.accentColor};`}>
            <span class="pbi-header-title" style={`color: ${project.accentColor}; opacity:0.9;`}>
              {project.year}
            </span>
            <a href={project.github} target="_blank" rel="noopener" aria-label="GitHub"
               style="color: var(--t4);" class="hover:text-[var(--t3)] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.113.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          </div>

          <div class="px-5 py-5 flex flex-col gap-4 flex-1">
            <h3 class="text-[15px] font-semibold leading-snug" style="color: var(--t1);">{project.title}</h3>
            <p class="text-[13px] leading-relaxed" style="color: var(--t3);">{project.description}</p>

            <ul class="space-y-1.5 flex-1">
              {project.highlights.map(h => (
                <li class="flex items-start gap-2 text-[12px]" style="color: var(--t2);">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-sm shrink-0" style={`background: ${project.accentColor};`}></span>
                  {h}
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-1.5 pt-2" style="border-top: 1px solid var(--border);">
              {project.tech.map(t => (
                <span class="tech-badge">{t}</span>
              ))}
              {project.playUrl && (
                <a href={project.playUrl}
                   class="ml-auto px-3 py-1 text-[11px] rounded-[3px] font-semibold transition-colors"
                   style={`background: ${project.accentColor}18; border: 1px solid ${project.accentColor}35; color: ${project.accentColor};`}>
                  Play →
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

  </div><!-- /max-w -->
</section>
