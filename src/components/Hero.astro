<section class="min-h-screen flex items-center justify-center pt-20 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <!-- Greeting -->
    <p class="text-[#8b949e] text-sm tracking-widest uppercase mb-4">Hi, I'm</p>

    <!-- Name -->
    <h1 class="text-5xl sm:text-7xl font-bold mb-4 gradient-text">
      Anna Grzywa
    </h1>

    <!-- Animated subtitle -->
    <div class="h-10 flex items-center justify-center mb-6">
      <p id="typing-subtitle" class="text-lg sm:text-xl text-[#8b949e] typing-text"></p>
    </div>

    <!-- Bio -->
    <p class="text-[#e6edf3]/80 text-lg leading-relaxed max-w-2xl mx-auto mb-10">
      Aspiring Data Analyst with a Master's in Digital Economy, building end-to-end
      data projects in Python, SQL and Power BI. Currently a Data &amp; Analytics Intern
      at KPMG, turning raw data into decisions.
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-4 justify-center mb-12">
      <a
        href="#projects"
        class="px-7 py-3 rounded-full bg-[#7c3aed] hover:bg-[#6d28d9] text-white font-medium transition-colors duration-200"
      >
        See Projects
      </a>
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener"
        class="px-7 py-3 rounded-full border border-[#30363d] text-[#e6edf3] hover:border-[#7c3aed] hover:text-[#7c3aed] font-medium transition-colors duration-200"
      >
        Download CV
