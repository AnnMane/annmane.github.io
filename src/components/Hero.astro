  </div>
</section>

<script>
  const subtitles = [
    'Data Analyst',
    'KPMG Intern',
    'Python · Power BI · SQL',
  ];
  let currentIndex = 0;
  const el = document.getElementById('typing-subtitle');

  function typeText(text: string, cb: () => void) {
    if (!el) return;
    el.textContent = '';
    el.classList.add('typing-text');
    let i = 0;
    const interval = setInterval(() => {
      el.textContent += text[i];
      i++;
      if (i >= text.length) {
        clearInterval(interval);
        setTimeout(cb, 1800);
      }
    }, 60);
  }

  function eraseText(cb: () => void) {
    if (!el) return;
    const text = el.textContent || '';
    let i = text.length;
    const interval = setInterval(() => {
      el.textContent = text.slice(0, i - 1);
      i--;
      if (i <= 0) {
        clearInterval(interval);
        cb();
      }
    }, 35);
  }

  function loop() {
    typeText(subtitles[currentIndex], () => {
      eraseText(() => {
        currentIndex = (currentIndex + 1) % subtitles.length;
        loop();
      });
    });
  }

  loop();
</script>
