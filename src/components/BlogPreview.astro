---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section id="blog" class="section px-4" style="position: relative; overflow: hidden;">

  <!-- Orb accent -->
  <div class="orb orb-m" style="width:400px; height:400px; bottom:-60px; left:30%; opacity:0.5;"></div>

  <div class="max-w-6xl mx-auto" style="position: relative; z-index: 1;">

    <div class="mb-10 sr sr-up flex flex-col gap-1">
      <p class="section-eyebrow">Notes & Learning</p>
      <div class="flex items-end justify-between gap-4">
        <h2 class="section-title">Blog</h2>
        <a href="/blog" class="text-[13px] font-medium shrink-0 mb-1" style="color: var(--accent-v);">
          All posts →
        </a>
      </div>
      <p class="section-sub">Real problems, real fixes — documented as I learn.</p>
    </div>

    {posts.length === 0 ? (
      <div class="pbi-visual px-5 py-8 text-sm" style="color: var(--t3);">No posts yet — stay tuned!</div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class={`pbi-visual tilt block group sr sr-d${i + 1}`}>
            <div class="pbi-header" style="border-top: 3px solid #a855f7;">
              <time class="text-[11px]" style="color: var(--t3);">
                {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span class="pbi-header-dots">···</span>
            </div>
            <div class="px-5 py-4">
              <h3 class="text-[14px] font-semibold leading-snug mb-2 transition-colors"
                  style="color: var(--t1);">
                {post.data.title}
              </h3>
              <p class="text-[12px] line-clamp-3 mb-3" style="color: var(--t3);">{post.data.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags?.map((tag: string) => (
                  <span class="px-2 py-0.5 text-[10px] rounded-[2px]"
                        style="background: rgba(124,58,237,0.1); border: 1px solid rgba(124,58,237,0.2); color: #a78bfa;">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

  </div><!-- /max-w -->
</section>
