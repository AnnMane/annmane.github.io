---
const navLinks = [
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '/blog', label: 'Blog' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[#0d1117]/80 backdrop-blur-md border-b border-[#30363d]">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-bold text-lg gradient-text">AG</a>
    <ul class="flex gap-6 text-sm">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-[#8b949e] hover:text-[#e6edf3] transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/cv.pdf"
      target="_blank"
      rel="noopener"
      class="hidden sm:inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#7c3aed] text-[#7c3aed] text-sm hover:bg-[#7c3aed]/10 transition-colors duration-200"
    >
      Resume
    </a>
  </div>
</nav>
