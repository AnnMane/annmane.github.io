---
const navLinks = [
  { href: '/#projects',   label: 'Projects'  },
  { href: '/#skills',     label: 'Skills'    },
  { href: '/blog',        label: 'Blog'      },
  { href: '/minesweeper', label: '💣 Play'   },
];
---

<div class="fixed top-0 left-0 right-0 z-50">
  <!-- Gradient accent line -->
  <div class="h-[3px] bg-gradient-to-r from-[#7c3aed] via-[#a855f7] to-[#06b6d4]"></div>

  <nav style="background: var(--nav-bg); border-bottom: 1px solid var(--border); backdrop-filter: blur(14px);">
    <div class="max-w-6xl mx-auto px-5 h-11 flex items-center justify-between gap-4">

      <!-- Logo -->
      <div class="flex items-center gap-2.5 shrink-0">
        <div class="w-5 h-5 rounded-[3px] bg-gradient-to-br from-[#7c3aed] to-[#06b6d4] flex items-center justify-center">
          <svg width="11" height="11" viewBox="0 0 12 12" fill="white">
            <rect x="0" y="5" width="3" height="7" rx="0.5"/>
            <rect x="4.5" y="2.5" width="3" height="9.5" rx="0.5"/>
            <rect x="9" y="0" width="3" height="12" rx="0.5"/>
          </svg>
        </div>
        <a href="/" class="text-[13px] font-semibold tracking-tight" style="color: var(--t1);">Anna Grzywa</a>
      </div>

      <!-- Nav links -->
      <ul class="flex items-stretch h-11">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="nav-link h-full px-4 flex items-center text-[12px]"
               style="color: var(--t3); border-right: 1px solid var(--border);">
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Right: contact icons + theme toggle -->
      <div class="flex items-center gap-3 shrink-0">
        <a href="https://www.linkedin.com/in/annagrzywa/" target="_blank" rel="noopener"
           aria-label="LinkedIn" class="icon-btn" style="color: var(--t3);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="mailto:a.grzywa01@gmail.com" aria-label="Email" class="icon-btn" style="color: var(--t3);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </a>
        <a href="https://github.com/AnnMane" target="_blank" rel="noopener" aria-label="GitHub" class="icon-btn" style="color: var(--t3);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.113.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>

        <!-- ── Theme Toggle ───────────────────────────── -->
        <button id="theme-toggle" aria-label="Toggle light/dark mode" class="toggle-pill">
          <span class="toggle-track">
            <span class="toggle-thumb"></span>
          </span>
          <!-- Sun (left) -->
          <svg class="icon-sun" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Moon (right) -->
          <svg class="icon-moon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>

    </div>
  </nav>
</div>

<style>
  .nav-link { transition: color 0.15s, background 0.15s; }
  .nav-link:hover { color: var(--t1) !important; background: var(--surface); }

  .icon-btn { transition: color 0.15s; }
  .icon-btn:hover { color: var(--accent-c) !important; }

  /* ── Toggle pill ─────────────────────────── */
  .toggle-pill {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 4px 7px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .toggle-pill:hover { border-color: var(--accent-v); }

  .toggle-track {
    position: relative;
    width: 26px;
    height: 14px;
    background: var(--border);
    border-radius: 7px;
    transition: background 0.25s;
  }
  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--t3);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.25s;
  }

  /* Dark mode state: thumb right, track violet */
  :root:not(.light) .toggle-track { background: rgba(124, 58, 237, 0.35); }
  :root:not(.light) .toggle-thumb { transform: translateX(12px); background: #a78bfa; }

  /* Light mode state: thumb left, track cyan */
  :root.light .toggle-track { background: rgba(6, 182, 212, 0.25); }
  :root.light .toggle-thumb { transform: translateX(0); background: #06b6d4; }

  /* Icon colors */
  .icon-sun  { color: var(--t3); transition: color 0.2s; }
  .icon-moon { color: var(--t3); transition: color 0.2s; }
  :root.light  .icon-sun  { color: #f59e0b; }
  :root:not(.light) .icon-moon { color: #a78bfa; }
</style>

<script>
  const btn   = document.getElementById('theme-toggle')!;
  const html  = document.documentElement;

  btn.addEventListener('click', () => {
    const isLight = html.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  });
</script>
