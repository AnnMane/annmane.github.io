---
// Data Pipeline — Spectacular ETL Scrollytelling
const nodes = [
  {
    emoji: '🕷️',
    title: 'Scrape',
    tool: 'BeautifulSoup',
    stat: '2400',
    statLabel: 'job postings',
    pct: 100,
    color: '#7c3aed',
    details: [
      'Scraped Pracuj.pl & NoFluffJobs',
      'Rate-limited · robots.txt respected',
      'Pagination handling across 80 pages',
      'Raw HTML → structured JSON',
    ],
  },
  {
    emoji: '🧹',
    title: 'Clean',
    tool: 'Pandas',
    stat: '9',
    statLabel: 'null columns dropped',
    pct: 85,
    color: '#8b5cf6',
    details: [
      'Deduplication & null imputation',
      'Salary B2B/UoP normalization',
      'Tech stack regex extraction',
      'Type casting + date parsing',
    ],
  },
  {
    emoji: '⭐',
    title: 'Model',
    tool: 'SQL',
    stat: '4',
    statLabel: 'dimension tables',
    pct: 90,
    color: '#06b6d4',
    details: [
      'Fact: job_postings (2,391 rows)',
      'Dim: companies · locations · tech',
      'Bridge table: posting_skills (M:N)',
      'Composite PKs · referential integrity',
    ],
  },
  {
    emoji: '📊',
    title: 'Visualize',
    tool: 'Power BI',
    stat: '3',
    statLabel: 'dashboard pages',
    pct: 100,
    color: '#0ea5e9',
    details: [
      'Page 1: Market overview & salary',
      'Page 2: Tech stack heatmap',
      'Page 3: Location & remote trends',
      'DAX measures · drill-through filters',
    ],
  },
];
---

<section id="pipeline" class="section px-4" style="position:relative;overflow:hidden;">

  <!-- Background orbs -->
  <div class="orb orb-v" style="width:600px;height:600px;top:-120px;left:-180px;opacity:0.25;"></div>
  <div class="orb orb-c" style="width:400px;height:400px;bottom:-80px;right:-100px;opacity:0.2;"></div>

  <div class="max-w-6xl mx-auto" style="position:relative;z-index:1;">

    <div class="mb-12 sr sr-up">
      <p class="section-eyebrow">IT Job Market Analysis · End-to-End</p>
      <h2 class="section-title">Data Pipeline</h2>
      <p class="section-sub">From raw HTML to interactive dashboard — watch each stage activate live.</p>
    </div>

    <div class="pipeline-wrap" id="pipeline-wrap" style="padding-bottom:20px;">

      <!-- SVG connector layer -->
      <svg class="pipeline-svg" id="pipeline-svg" aria-hidden="true">
        <defs>
          <!-- Gradient for paths -->
          <linearGradient id="pg" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"   stop-color="#7c3aed"/>
            <stop offset="100%" stop-color="#06b6d4"/>
          </linearGradient>
          <!-- Glow filter for paths -->
          <filter id="path-glow" x="-50%" y="-200%" width="200%" height="500%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="blur"/>
          </filter>
          <!-- Particle glow -->
          <filter id="ptcl-glow" x="-100%" y="-100%" width="300%" height="300%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="2.5"/>
          </filter>
        </defs>
      </svg>

      <!-- Scanner sweep line -->
      <div class="pipe-scanner" id="pipe-scanner"></div>

      <!-- Node cards -->
      <div class="pipeline-nodes-row" id="pipeline-nodes">
        {nodes.map((node, i) => (
          <div
            class="pipe-node"
            data-idx={i}
            data-pct={node.pct}
            data-stat={node.stat}
            style={`--nc: ${node.color};`}
          >
            <div class="pipe-node-inner">

              <!-- Step badge -->
              <div style={`position:absolute;top:14px;right:14px;
                           width:22px;height:22px;border-radius:50%;
                           background:rgba(${node.color === '#7c3aed' ? '124,58,237' : node.color === '#8b5cf6' ? '139,92,246' : node.color === '#06b6d4' ? '6,182,212' : '14,165,233'},0.15);
                           border:1px solid ${node.color}44;
                           display:flex;align-items:center;justify-content:center;
                           font-size:10px;font-weight:700;color:${node.color};`}>
                {i + 1}
              </div>

              <!-- Icon with pulse rings -->
              <div class="pipe-icon-wrap">
                <div class="pipe-ring"></div>
                <div class="pipe-ring"></div>
                <div class="pipe-icon-face">{node.emoji}</div>
              </div>

              <!-- Title + tool -->
              <div style={`font-size:15px;font-weight:800;letter-spacing:0.01em;color:${node.color};margin-bottom:3px;`}>
                {node.title}
              </div>
              <div style="font-size:11px;color:var(--t4);font-family:'SF Mono',Consolas,monospace;">
                {node.tool}
              </div>

              <!-- Animated stat counter -->
              <div class="pipe-stat" data-target={node.stat} data-counter>0</div>
              <div style="font-size:10px;color:var(--t3);margin-top:-2px;">{node.statLabel}</div>

              <!-- Progress bar -->
              <div class="pipe-progress-track">
                <div class="pipe-progress-bar" data-pct={node.pct}></div>
              </div>

              <!-- Expandable details -->
              <div class="pipe-details">
                <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border-2);">
                  {node.details.map(d => (
                    <div style="font-size:11px;color:var(--t3);padding:2px 0;display:flex;gap:6px;align-items:flex-start;">
                      <span style={`color:${node.color};flex-shrink:0;font-weight:700;`}>›</span>
                      {d}
                    </div>
                  ))}
                </div>
              </div>

              <!-- Click hint -->
              <div style="font-size:10px;color:var(--t4);margin-top:12px;text-align:right;letter-spacing:0.04em;">
                click to expand
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Step dots -->
      <div style="display:flex;justify-content:center;gap:10px;margin-top:24px;">
        {nodes.map((node, i) => (
          <div class={`pipe-dot-${i}`}
               style={`width:8px;height:8px;border-radius:50%;
                       background:${node.color};opacity:0.3;
                       transition:opacity 0.3s,transform 0.3s;`}></div>
        ))}
      </div>

    </div><!-- /pipeline-wrap -->
  </div><!-- /max-w -->
</section>

<script is:inline>
(function () {
  var svg      = document.getElementById('pipeline-svg');
  var wrap     = document.getElementById('pipeline-wrap');
  var scanner  = document.getElementById('pipe-scanner');
  var nodeEls  = document.querySelectorAll('.pipe-node');
  var paths    = [];       // { glow, mid, sharp, len }
  var ptcls    = [];       // { circle, glowCircle, path, len, offset, speed, r }
  var animId   = null;
  var activated = false;

  // ── Build triple-layer SVG paths ─────────────────────────────────
  function buildPaths() {
    svg.querySelectorAll('.dyn').forEach(function (el) { el.remove(); });
    paths = [];
    ptcls = [];

    if (window.innerWidth < 768) return;

    var wRect = wrap.getBoundingClientRect();

    for (var i = 0; i < nodeEls.length - 1; i++) {
      var r1 = nodeEls[i].getBoundingClientRect();
      var r2 = nodeEls[i + 1].getBoundingClientRect();
      var cy1 = r1.top + r1.height / 2;
      var cy2 = r2.top + r2.height / 2;
      if (Math.abs(cy1 - cy2) > r1.height * 0.8) continue;

      var x1 = r1.right  - wRect.left;
      var y1 = cy1 - wRect.top;
      var x2 = r2.left   - wRect.left;
      var y2 = cy2 - wRect.top;
      var cx = x1 + (x2 - x1) * 0.5;
      var d  = 'M ' + x1 + ',' + y1 + ' C ' + cx + ',' + y1 + ' ' + cx + ',' + y2 + ' ' + x2 + ',' + y2;

      // Layer 1 – fat glow (blurry)
      var glow = makePath(d, 14, 'url(#pg)', 0.18, 'url(#path-glow)');
      // Layer 2 – medium
      var mid  = makePath(d, 2.5, 'url(#pg)', 0.7, null);
      // Layer 3 – sharp bright line
      var sharp = makePath(d, 1,  '#ffffff', 0.25, null);

      svg.appendChild(glow);
      svg.appendChild(mid);
      svg.appendChild(sharp);

      var len = mid.getTotalLength();
      // Set dashoffset for draw-in
      [glow, mid, sharp].forEach(function (p) {
        p.style.strokeDasharray  = String(len);
        p.style.strokeDashoffset = String(len);
      });

      paths.push({ glow: glow, mid: mid, sharp: sharp, len: len });

      // ── Particles (8 per path) ─────────────────────────────────
      var sizes  = [6, 5, 4, 4, 3, 3, 2, 2];
      var speeds = [0.5, 0.38, 0.28, 0.22, 0.45, 0.32, 0.18, 0.4];
      var colors = ['#7c3aed','#06b6d4','#a78bfa','#38bdf8','#7c3aed','#06b6d4','#a78bfa','#38bdf8'];

      for (var j = 0; j < 8; j++) {
        var c = mkCircle(sizes[j], colors[j], 0, null);
        var cg = mkCircle(sizes[j] + 3, colors[j], 0, 'url(#ptcl-glow)');
        svg.appendChild(cg);
        svg.appendChild(c);
        ptcls.push({
          circle: c, glow: cg,
          path: mid, len: len,
          offset: j / 8,
          speed: speeds[j],
          r: sizes[j]
        });
      }
    }

    if (activated) showPaths(true);
  }

  function makePath(d, sw, stroke, opacity, filter) {
    var p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    p.setAttribute('d', d);
    p.setAttribute('fill', 'none');
    p.setAttribute('stroke', stroke);
    p.setAttribute('stroke-width', sw);
    p.setAttribute('stroke-linecap', 'round');
    p.setAttribute('opacity', opacity);
    p.classList.add('dyn');
    if (filter) p.setAttribute('filter', filter);
    return p;
  }

  function mkCircle(r, fill, opacity, filter) {
    var c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('r', r);
    c.setAttribute('fill', fill);
    c.setAttribute('opacity', opacity);
    c.classList.add('dyn');
    if (filter) c.setAttribute('filter', filter);
    return c;
  }

  // ── Sequential path draw-in ───────────────────────────────────────
  var delays = [300, 650, 1000];

  function showPaths(instant) {
    activated = true;
    paths.forEach(function (p, i) {
      var d = instant ? 0 : (delays[i] || i * 350);
      setTimeout(function () {
        var ease = 'stroke-dashoffset 1.3s cubic-bezier(0.16,1,0.3,1)';
        p.glow.style.transition  = ease;
        p.mid.style.transition   = ease;
        p.sharp.style.transition = 'stroke-dashoffset 1.3s cubic-bezier(0.16,1,0.3,1) 0.1s';
        p.glow.style.strokeDashoffset  = '0';
        p.mid.style.strokeDashoffset   = '0';
        p.sharp.style.strokeDashoffset = '0';

        // After last path drawn → flowing mode + particles visible
        if (i === paths.length - 1) {
          setTimeout(function () {
            paths.forEach(function (p2) {
              p2.glow.classList.add('pipe-flowing');
              p2.mid.classList.add('pipe-flowing');
              p2.sharp.classList.add('pipe-flowing');
            });
            ptcls.forEach(function (pt) {
              pt.circle.setAttribute('opacity', '0.9');
              pt.glow.setAttribute('opacity', '0.35');
            });
            if (!animId) startParticles();
          }, 1400);
        }
      }, d);
    });
  }

  // ── Particle animation ────────────────────────────────────────────
  function startParticles() {
    var last = 0;
    function tick(t) {
      var dt = last ? Math.min((t - last) / 1000, 0.08) : 0;
      last = t;
      for (var i = 0; i < ptcls.length; i++) {
        var pt = ptcls[i];
        pt.offset = (pt.offset + pt.speed * dt) % 1;
        var pos = pt.path.getPointAtLength(pt.offset * pt.len);
        pt.circle.setAttribute('cx', pos.x);
        pt.circle.setAttribute('cy', pos.y);
        pt.glow.setAttribute('cx', pos.x);
        pt.glow.setAttribute('cy', pos.y);
      }
      animId = requestAnimationFrame(tick);
    }
    animId = requestAnimationFrame(tick);
  }

  // ── Counter animation ─────────────────────────────────────────────
  function runCounters() {
    nodeEls.forEach(function (node) {
      var el     = node.querySelector('[data-counter]');
      if (!el) return;
      var target = parseInt(el.getAttribute('data-target'), 10);
      var dur    = 1600;
      var start  = performance.now();
      function step(now) {
        var t   = Math.min((now - start) / dur, 1);
        var ease = 1 - Math.pow(1 - t, 4); // quartic ease-out
        el.textContent = Math.round(ease * target);
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = target;
      }
      requestAnimationFrame(step);
    });
  }

  // ── Progress bars ─────────────────────────────────────────────────
  function runBars() {
    nodeEls.forEach(function (node, i) {
      var bar = node.querySelector('.pipe-progress-bar');
      if (!bar) return;
      var pct = parseInt(bar.getAttribute('data-pct'), 10);
      setTimeout(function () {
        bar.style.width = pct + '%';
      }, i * 130);
    });
  }

  // ── Node click expand ─────────────────────────────────────────────
  var dots = [];
  for (var d = 0; d < 4; d++) {
    var dot = document.querySelector('.pipe-dot-' + d);
    if (dot) dots.push(dot);
  }

  nodeEls.forEach(function (node, i) {
    node.addEventListener('click', function () {
      var was = node.classList.contains('expanded');
      nodeEls.forEach(function (n) { n.classList.remove('expanded'); });
      dots.forEach(function (dot) { dot.style.opacity = '0.3'; dot.style.transform = 'scale(1)'; });
      if (!was) {
        node.classList.add('expanded');
        if (dots[i]) { dots[i].style.opacity = '1'; dots[i].style.transform = 'scale(1.4)'; }
      }
      setTimeout(buildPaths, 450);
    });
  });

  // ── Master activation on scroll ───────────────────────────────────
  var section = document.getElementById('pipeline');
  if (section) {
    var io = new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting) return;
      io.disconnect();

      // 1. Scanner sweep
      scanner.classList.add('go');

      // 2. Materialize nodes with stagger
      nodeEls.forEach(function (n) { n.classList.add('materialized'); });

      // 3. Counters + bars start after nodes appear
      setTimeout(runCounters, 400);
      setTimeout(runBars, 500);

      // 4. Path draw-in
      showPaths(false);

    }, { threshold: 0.2 });
    io.observe(section);
  }

  // ── Build after layout settled ────────────────────────────────────
  window.addEventListener('load', function () {
    requestAnimationFrame(function () { requestAnimationFrame(buildPaths); });
  });

  var rTimer;
  window.addEventListener('resize', function () {
    clearTimeout(rTimer);
    rTimer = setTimeout(buildPaths, 200);
  }, { passive: true });
})();
</script>
