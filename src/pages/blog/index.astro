---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog — Anna Grzywa" description="Notes on data analysis, Python, Power BI and learning in public.">
  <main class="max-w-3xl mx-auto px-6 pt-32 pb-20">
    <h1 class="text-4xl font-bold mb-2 gradient-text">Blog</h1>
    <p class="text-[#8b949e] mb-12">Notes on data, learning, and building things.</p>

    {posts.length === 0 ? (
      <p class="text-[#8b949e]">No posts yet — stay tuned!</p>
    ) : (
      <ul class="space-y-6">
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="glass-card p-6 block group">
              <time class="text-xs text-[#8b949e]">
                {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="mt-2 mb-2 text-xl font-semibold text-[#e6edf3] group-hover:text-white transition-colors">
                {post.data.title}
              </h2>
              <p class="text-sm text-[#8b949e]">{post.data.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-4">
                {post.data.tags?.map((tag: string) => (
                  <span class="px-2 py-0.5 text-xs rounded-full bg-[#06b6d4]/10 border border-[#06b6d4]/20 text-[#22d3ee]">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
