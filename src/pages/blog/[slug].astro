---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Anna Grzywa`} description={post.data.description}>
  <main class="max-w-2xl mx-auto px-6 pt-32 pb-20">
    <a href="/blog" class="inline-flex items-center gap-1 text-sm text-[#8b949e] hover:text-[#e6edf3] transition-colors mb-8">
      ← Back to blog
    </a>

    <article>
      <header class="mb-8">
        <time class="text-xs text-[#8b949e]">
          {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h1 class="text-3xl sm:text-4xl font-bold text-[#e6edf3] mt-2 mb-4 leading-tight">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags?.map((tag: string) => (
            <span class="px-2 py-0.5 text-xs rounded-full bg-[#06b6d4]/10 border border-[#06b6d4]/20 text-[#22d3ee]">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <div class="prose-content text-[#e6edf3]/90 leading-relaxed space-y-4">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .prose-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: #e6edf3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(h3) {
    font-size: 1.2rem;
    font-weight: 600;
    color: #e6edf3;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content :global(p) {
    margin-bottom: 1rem;
    color: #c9d1d9;
  }
  .prose-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: #c9d1d9;
  }
  .prose-content :global(li) {
    margin-bottom: 0.25rem;
  }
  .prose-content :global(strong) {
    color: #e6edf3;
    font-weight: 600;
  }
  .prose-content :global(code) {
    background: rgba(124, 58, 237, 0.15);
    color: #a78bfa;
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.875em;
  }
  .prose-content :global(pre) {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .prose-content :global(a) {
    color: #7c3aed;
    text-decoration: underline;
  }
  .prose-content :global(blockquote) {
    border-left: 3px solid #7c3aed;
    padding-left: 1rem;
    color: #8b949e;
    font-style: italic;
  }
</style>
