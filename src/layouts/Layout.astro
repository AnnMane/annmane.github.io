---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import SqlTerminal from '../components/SqlTerminal.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Anna Grzywa — Data Analyst',
  description = 'Portfolio of Anna Grzywa — Data Analyst, KPMG Intern, Python & Power BI specialist.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- No-flash theme script: runs before render -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        if (!isDark) document.documentElement.classList.add('light');
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <slot />

    <SqlTerminal />

    <!-- Apple wow effect: scroll-reveal + 3D tilt -->
    <script is:inline>
      // ── Scroll reveal ──────────────────────────────────────────
      (function () {
        const items = document.querySelectorAll('.sr, .sr-up, .sr-scale');
        if (!items.length) return;
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        items.forEach(el => io.observe(el));
      })();

      // ── 3-D card tilt ──────────────────────────────────────────
      (function () {
        const cards = document.querySelectorAll('.tilt');
        const MAX = 8; // degrees
        cards.forEach(card => {
          card.addEventListener('mousemove', (e) => {
            const r = card.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width  - 0.5;
            const y = (e.clientY - r.top)  / r.height - 0.5;
            card.style.transform =
              `perspective(1000px) rotateX(${-y * MAX}deg) rotateY(${x * MAX}deg) scale(1.02)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale(1)';
          });
        });
      })();

      // ── Navbar shrink on scroll ─────────────────────────────────
      (function () {
        const nav = document.querySelector('nav');
        if (!nav) return;
        window.addEventListener('scroll', () => {
          if (window.scrollY > 40) {
            nav.style.boxShadow = '0 1px 0 rgba(255,255,255,0.04), var(--shadow-sm)';
          } else {
            nav.style.boxShadow = '';
          }
        }, { passive: true });
      })();
    </script>

    <!-- Power BI page-tabs footer -->
    <footer class="mt-16 border-t" style="border-color: var(--border);">
      <div class="pbi-page-tabs">
        <a href="/" class="pbi-page-tab active">Home</a>
        <a href="/#projects" class="pbi-page-tab">Projects</a>
        <a href="/#skills" class="pbi-page-tab">Skills</a>
        <a href="/blog" class="pbi-page-tab">Blog</a>
        <a href="/minesweeper" class="pbi-page-tab">💣 Play</a>
        <div class="ml-auto px-4 flex items-center gap-4" style="font-size:11px; color: var(--border);">
          <a href="https://www.linkedin.com/in/annagrzywa/" target="_blank" rel="noopener"
             style="color: var(--t4);" class="hover:text-[var(--t3)] transition-colors">LinkedIn</a>
          <a href="mailto:a.grzywa01@gmail.com"
             style="color: var(--t4);" class="hover:text-[var(--t3)] transition-colors">a.grzywa01@gmail.com</a>
          <a href="https://github.com/AnnMane" target="_blank" rel="noopener"
             style="color: var(--t4);" class="hover:text-[var(--t3)] transition-colors">GitHub</a>
        </div>
      </div>
      <div class="px-4 py-1.5 flex items-center justify-between" style="font-size:10px; color: var(--border); background: var(--bg);">
        <span>Anna Grzywa · Data Analytics Portfolio</span>
        <span>© 2026</span>
      </div>
    </footer>
  </body>
</html>
