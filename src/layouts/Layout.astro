---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Anna Grzywa — Data Analyst',
  description = 'Portfolio of Anna Grzywa — Data Analyst, KPMG Intern, Python & Power BI specialist.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <slot />

    <!-- Power BI-style page tabs footer -->
    <footer class="mt-16 border-t border-[#2a2d35]">
      <!-- Page tabs row -->
      <div class="pbi-page-tabs">
        <a href="/" class="pbi-page-tab active">Home</a>
        <a href="/#projects" class="pbi-page-tab">Projects</a>
        <a href="/#skills" class="pbi-page-tab">Skills</a>
        <a href="/blog" class="pbi-page-tab">Blog</a>
        <div class="ml-auto px-4 flex items-center text-[11px] text-[#3d4149] gap-4">
          <a href="https://www.linkedin.com/in/annagrzywa/" target="_blank" rel="noopener" class="hover:text-[#8b949e] transition-colors">LinkedIn</a>
          <a href="mailto:a.grzywa01@gmail.com" class="hover:text-[#8b949e] transition-colors">a.grzywa01@gmail.com</a>
          <a href="https://github.com/AnnMane" target="_blank" rel="noopener" class="hover:text-[#8b949e] transition-colors">GitHub</a>
        </div>
      </div>
      <!-- Status bar -->
      <div class="bg-[#111318] border-t border-[#2a2d35] px-4 py-1.5 flex items-center justify-between text-[10px] text-[#3d4149]">
        <span>Anna Grzywa · Data Analytics Portfolio</span>
        <span>© 2026</span>
      </div>
    </footer>
  </body>
</html>
